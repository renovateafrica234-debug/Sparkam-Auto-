# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Meta Graph API Credentials for @sparkam.media
IG_USER_ID_SPARKAM="your_sparkam_instagram_user_id"
IG_TOKEN_SPARKAM="your_long_lived_sparkam_token"

# Meta Graph API Credentials for @zeeteroliver
IG_USER_ID_ZEETER="your_zeeter_instagram_user_id"
IG_TOKEN_ZEETER="your_long_lived_zeeter_token"

# Facebook Page ID connected to the Instagram Business Account
FB_PAGE_ID="your_facebook_page_id"

# Google Sheets CRM & Waitlist
GOOGLE_SHEET_ID="1BGO3RB..."
GOOGLE_SERVICE_ACCOUNT_JSON="{\"type\": \"service_account\", ...}"

# Paystack Secret Key
PAYSTACK_SECRET="sk_test_..."

# Vercel KV Storage (Optional fallback)
VERCEL_KV_URL="redis://..."
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Vercel Cron Secret (Optional, for securing /api/cron/daily-publisher)
CRON_SECRET="optional_cron_bearer_token"

